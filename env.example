# Example environment variables for portable runner
HF_TOKEN=YOUR_HF_TOKEN_HERE
# Provider selection
LLM_PROVIDER=openrouter

# OpenAI-compatible endpoint (for custom provider)
BASE_URL=https://your-company-endpoint/openai/v1
API_KEY=YOUR_API_KEY_HERE
LLM_MODEL=gpt-4.1

# Optional provider-specific examples
# OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY_HERE
# OPENROUTER_LLM_MODEL=openai/gpt-oss-20b:free
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional OpenRouter provider routing defaults
# Use one of these styles:
# OPENROUTER_PROVIDER_JSON={"only":["openai"]}
# OPENROUTER_PROVIDER_ONLY=openai
# OPENROUTER_PROVIDER_IGNORE=deepinfra
# OPENROUTER_PROVIDER_PREFER=azure
